# =============================================================================
# ROSEN CUSW Team Flow — plantilla de variables de entorno
# =============================================================================
# Copia este archivo y rellena los valores marcados como CAMBIAR:
#
#   cp .env.example .env                       # desarrollo del SPA
#   cp .env.example docker/.env                # stack self-hosted (compose)
#
# Genera valores aleatorios con:  openssl rand -hex 32
#
# Escenarios cubiertos:
#   A) DESARROLLO — SPA en local contra un backend Supabase ya existente.
#      Solo hace falta la sección 1 (VITE_*).
#   B) PRODUCCIÓN INTERNA — stack completo con docker/docker-compose.yml.
#      Hacen falta las secciones 1 a 6 en docker/.env.
#
# Cada variable lleva dos ejemplos: "dev:" (localhost) y "prod:" (intranet).
# Guía completa: DEPLOYMENT.md (secciones 3, 5 y 11).
#
# IMPORTANTE: nunca comitees el `.env` real. Solo esta plantilla se versiona.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Frontend (Vite) — leídas en build por src/integrations/supabase/client.ts
# -----------------------------------------------------------------------------
# Son valores públicos por diseño: viajan en el bundle del navegador y RLS es
# lo que protege los datos. Deben estar presentes en el momento del build.

# URL pública del API gateway de Supabase (Kong en self-hosted).
#   dev:  http://localhost:8000
#   prod: https://teamflow-api.intranet.rosen.local
VITE_SUPABASE_URL=http://localhost:8000

# Clave publishable/anon (JWT firmado con JWT_SECRET). Debe coincidir con ANON_KEY.
#   dev:  el ANON_KEY que generes para el stack local
#   prod: el ANON_KEY del entorno de intranet
VITE_SUPABASE_PUBLISHABLE_KEY=CAMBIAR_anon_key_jwt

# Identificador del proyecto (slug libre en self-hosted).
#   dev:  local
#   prod: rosen-team-flow
VITE_SUPABASE_PROJECT_ID=local


# -----------------------------------------------------------------------------
# 2. Postgres (solo self-hosted — docker/.env)
# -----------------------------------------------------------------------------
# Contraseña del superusuario postgres. Mínimo 24 caracteres aleatorios.
#   dev:  openssl rand -hex 24
#   prod: gestionada por el gestor de secretos corporativo, rotación anual
POSTGRES_PASSWORD=CAMBIAR_password_seguro

# Cadena de conexión usada por los scripts de base de datos (make db-*).
#   dev:  postgres://postgres:<pwd>@localhost:5432/postgres
#   prod: postgres://postgres:<pwd>@db.intranet.rosen.local:5432/postgres
# DB_URL=postgres://postgres:CAMBIAR@localhost:5432/postgres


# -----------------------------------------------------------------------------
# 3. JWT compartido (GoTrue / PostgREST / Realtime / Edge Functions)
# -----------------------------------------------------------------------------
# Todos los servicios deben usar EXACTAMENTE el mismo valor. Mínimo 32 chars.
#   dev / prod: openssl rand -hex 32
JWT_SECRET=CAMBIAR_jwt_secret_min_32_chars

# ANON_KEY y SERVICE_ROLE_KEY son JWT firmados con JWT_SECRET. Genéralos una vez
# siguiendo https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
# ANON_KEY es público; SERVICE_ROLE_KEY es secreto y NUNCA debe llegar al cliente.
ANON_KEY=CAMBIAR_jwt_anon
SERVICE_ROLE_KEY=CAMBIAR_jwt_service_role

# Base secreta de Realtime (64 caracteres).
#   dev / prod: openssl rand -hex 64
REALTIME_SECRET_KEY_BASE=CAMBIAR_64_chars_aleatorio


# -----------------------------------------------------------------------------
# 4. URLs públicas y Auth
# -----------------------------------------------------------------------------
# URL desde donde el navegador accede a la SPA (redirecciones de Auth).
#   dev:  http://localhost:8080
#   prod: https://teamflow.intranet.rosen.local
SITE_URL=http://localhost:8080

# URL desde donde el navegador llama al API gateway (igual que VITE_SUPABASE_URL).
#   dev:  http://localhost:8000
#   prod: https://teamflow-api.intranet.rosen.local
PUBLIC_SUPABASE_URL=http://localhost:8000

# URL externa que GoTrue incluye en sus enlaces.
#   dev:  http://localhost:8000
#   prod: https://teamflow-api.intranet.rosen.local
API_EXTERNAL_URL=http://localhost:8000

# Registro de usuarios. Ábrelo para dar de alta al equipo y ciérralo después.
#   dev:  false
#   prod: true  (una vez registrado el equipo)
GOTRUE_DISABLE_SIGNUP=false

# Confirmación de email. En intranet sin SMTP, déjalo en true.
#   dev:  true
#   prod: false si configuras SMTP corporativo, true si no hay correo
GOTRUE_MAILER_AUTOCONFIRM=true

# SMTP corporativo (opcional, solo si GOTRUE_MAILER_AUTOCONFIRM=false).
# GOTRUE_SMTP_HOST=smtp.rosen.local
# GOTRUE_SMTP_PORT=587
# GOTRUE_SMTP_USER=teamflow@rosen.local
# GOTRUE_SMTP_PASS=CAMBIAR_smtp_password
# GOTRUE_SMTP_ADMIN_EMAIL=teamflow@rosen.local


# -----------------------------------------------------------------------------
# 5. Edge Functions (tfs-pat-vault, ado-public-connection)
# -----------------------------------------------------------------------------
# Estas tres las inyecta el runtime de Supabase automáticamente en producción
# gestionada; en self-hosted las define docker/docker-compose.yml a partir de
# las secciones 2-4:
#   SUPABASE_URL              -> http://kong:8000
#   SUPABASE_ANON_KEY         -> ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY -> SERVICE_ROLE_KEY

# Clave AES-256-GCM (32 bytes en hex = 64 chars) para cifrar los PAT de Azure
# DevOps guardados en la base de datos.
#   dev / prod: openssl rand -hex 32
# Respáldala en un gestor de secretos: si se pierde, los PAT guardados quedan
# irrecuperables y hay que volver a introducirlos desde /settings.
ADO_PAT_ENC_KEY=CAMBIAR_64_hex_chars

# Validación de JWT en el edge runtime local. Debe ser "false" porque cada
# función valida el token por su cuenta (ado-public-connection es pública).
#   dev / prod: false
VERIFY_JWT=false


# -----------------------------------------------------------------------------
# 6. Azure DevOps / TFS (opcional)
# -----------------------------------------------------------------------------
# La conexión se configura desde la UI en /settings (solo admin) y se guarda
# cifrada en la base de datos. Estas variables solo documentan el entorno.
#   dev:  https://dev.azure.com/tu-organizacion
#   prod: https://tfs.rosen.local/tfs/DefaultCollection
# TFS_BASE_URL=

# Límites de peticiones que la app aplica sobre la conexión compartida.
#   dev:  120 / 60
#   prod: 300 / 60 si el equipo es grande
# PROXY_RATE_LIMIT_MAX_REQUESTS=120
# PROXY_RATE_LIMIT_WINDOW_SECONDS=60
